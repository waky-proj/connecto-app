# Connecto.Api HTTP launch profile. Vite proxies /api to this server.
CONNECTO_API_TARGET=http://localhost:5247
# For a separately hosted frontend only (requires backend CORS).
VITE_CONNECTO_API_BASE_URL=
# Match the backend Cognito:Issuer region and Cognito:Audience app client.
# Use a PUBLIC client without a secret, with ALLOW_USER_PASSWORD_AUTH and
# ALLOW_REFRESH_TOKEN_AUTH enabled and refresh token rotation disabled.
VITE_COGNITO_REGION=ap-southeast-2
VITE_COGNITO_CLIENT_ID=
